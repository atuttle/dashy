# Server-only secret. Copy this file to .env.local; never prefix the key with VITE_.
PIRATE_WEATHER_API_KEY=your-api-key

# Private, read-only calendar feeds used by the localhost development server.
# Personal and work feeds map to Dad; shared events map to Family.
ICAL_DAD_PERSONAL_URL=
ICAL_DAD_WORK_URL=
ICAL_MOM_URL=
ICAL_KIDDO_URL=
ICAL_FAMILY_URL=

# Separate countdown calendar; refreshes at 6 AM, noon, and 5 PM Eastern.
ICAL_COUNTDOWNS_URL=

# Optional Google Photos link-shared album. Kept server/native-only.
GOOGLE_PHOTOS_ALBUM_URL=

# Optional driving estimates; server/native-only, never VITE_ variables.
DASHY_HOME_ADDRESS=
TOMTOM_API_KEY=
